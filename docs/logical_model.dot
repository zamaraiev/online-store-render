// Lab 3, task 3.4.3: logical model of the "Online store" database (Azure SQL)
// Render: dot -Tpng -Gdpi=200 logical_model.dot -o logical_model.png
digraph LogicalModel {
    graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.6, ranksep=1.3,
           fontname="Helvetica", fontsize=16, labelloc=t,
           label=<<B>Logical model of the &quot;Online store&quot; database (Azure SQL)</B><BR/> >];
    node  [shape=plaintext, fontname="Helvetica", fontsize=11];
    edge  [fontname="Helvetica", fontsize=11, color="#333333", penwidth=1.4, dir=both, arrowsize=1.2];

    Customers [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2b5797">
        <TR><TD COLSPAN="4" BGCOLOR="#2b5797"><FONT COLOR="white"><B>Customers</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>CustomerCode</U></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD ALIGN="LEFT" PORT="pk"><FONT COLOR="#555555">NOT NULL</FONT></TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">LastName</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NVARCHAR(50)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NOT NULL</FONT></TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">FirstName</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NVARCHAR(50)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NOT NULL</FONT></TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Patronymic</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NVARCHAR(50)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NULL</FONT></TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Address</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NVARCHAR(200)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NOT NULL</FONT></TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Phone</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(20)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NOT NULL</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">Email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NOT NULL</FONT></TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">RegularCustomer</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">BIT DEFAULT 0</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NOT NULL</FONT></TD></TR>
        <TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="10">RegularCustomer = 1 when purchases &gt; 5000 UAH (2% discount)</FONT></TD></TR>
      </TABLE>>];

    Sales [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#a0522d">
        <TR><TD COLSPAN="4" BGCOLOR="#a0522d"><FONT COLOR="white"><B>Sales</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><U>SaleCode</U></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NOT NULL</FONT></TD></TR>
        <TR><TD ALIGN="LEFT" PORT="customer"><B>FK</B></TD><TD ALIGN="LEFT">CustomerCode</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NOT NULL</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">ProductCode</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD ALIGN="LEFT" PORT="product"><FONT COLOR="#555555">NOT NULL</FONT></TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">SaleDate</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATE</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NOT NULL</FONT></TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">DeliveryDate</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATE</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NOT NULL</FONT></TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Quantity</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DECIMAL(10,3)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NOT NULL</FONT></TD></TR>
        <TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#f8f0eb"><FONT POINT-SIZE="10">CHECK: Quantity &gt; 0; DeliveryDate &gt;= SaleDate</FONT></TD></TR>
      </TABLE>>];

    Products [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2e7d32">
        <TR><TD COLSPAN="4" BGCOLOR="#2e7d32"><FONT COLOR="white"><B>Products</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT" PORT="pk"><B>PK</B></TD><TD ALIGN="LEFT"><U>ProductCode</U></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">INT</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NOT NULL</FONT></TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NVARCHAR(100)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NOT NULL</FONT></TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Price</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DECIMAL(10,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NOT NULL</FONT></TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Unit</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NVARCHAR(10)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#555555">NOT NULL</FONT></TD></TR>
        <TR><TD COLSPAN="4" ALIGN="LEFT" BGCOLOR="#edf5ee"><FONT POINT-SIZE="10">CHECK: Price &gt; 0; Unit IN ('pcs', 'kg', 'l')</FONT></TD></TR>
      </TABLE>>];

    Customers:pk:e -> Sales:customer:w [arrowtail=teetee, arrowhead=crow, label="FK_Sales_Customers\n1 : N"];
    Sales:product:e -> Products:pk:w   [arrowtail=crow, arrowhead=teetee, label="FK_Sales_Products\nN : 1"];
}
